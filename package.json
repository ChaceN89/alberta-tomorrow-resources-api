{
  "name": "alberta-tomorrow-resources-api",
  "version": "1.0.0",
  "description": "videos and lesson plans for alberta tomorrow",
  "main": "dist/lambda.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && node dist/src/app.js",
    "dev": "tsx watch src/app.ts",
    "lambda": "npm run build && NODE_ENV=lambda node dist/lambda.js",
    "generate": "tsx src/data/scripts/generate.ts",
    "generate:lessons": "tsx src/data/scripts/generateLessonPlans.ts",
    "generate:videos": "tsx src/data/scripts/generateVideos.ts",
    "pullyoutube": "tsx src/data/scripts/pullYouTubeData.ts",
    "pulllessonpdfs": "tsx src/data/scripts/pullLessonPlanPdfs.ts",
    "audit:resources": "tsx src/data/scripts/auditResourceLinks.ts",
    "test": "npm run typecheck && tsc -p tests/tsconfig.json && node --import tsx --test tests/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@vendia/serverless-express": "^4.12.6",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
